# Variables del VPS. Copia a `deploy/.env` (queda fuera de git) y completa. Lo lee Docker Compose (interpolación) y
# también va como secreto de build a `next build`. Valores simples (sin espacios ni `$`), salvo los entre comillas.
# Guía: docs/vps-migration.md · Significado de cada variable de la app: .env.example (raíz del repo)

# ─── Dominios ──────────────────────────────────────────────────────────────────────────────────────
# Producción. DNS: un registro A (y AAAA) de cada uno hacia la IP del servidor.
SITE_HOST=guerracampal.cl
ADMIN_HOST=admin.guerracampal.cl
WWW_HOST=www.guerracampal.cl
MEDIA_HOST=media.guerracampal.cl
STATS_HOST=stats.guerracampal.cl
SITE_URL=https://guerracampal.cl
ADMIN_URL=https://admin.guerracampal.cl
# Correo para los avisos de Let's Encrypt (certificados).
ACME_EMAIL=tu-correo@dominio.cl
# La app habla con MinIO por la dirección pública (Caddy): las URLs de subida van firmadas para ese dominio.
MEDIA_HOST_ALIAS=media.guerracampal.cl
S3_ENDPOINT=https://media.guerracampal.cl
S3_PUBLIC_URL=https://media.guerracampal.cl/guerra-campal
MINIO_CORS_ORIGINS=https://guerracampal.cl,https://admin.guerracampal.cl

# ─── Base de datos ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=guerra_campal
# Dirección de la base VISTA DESDE EL BUILD de la imagen: el build usa la red del servidor (`network: host`) y llega al
# Postgres del compose publicado en 127.0.0.1 (puerto POSTGRES_PORT, 5432 por defecto).
BUILD_DATABASE_URL=postgres://postgres:cambia-esta-clave@127.0.0.1:5432/guerra_campal

# ─── Secretos ──────────────────────────────────────────────────────────────────────────────────────
# Genera cada uno con: openssl rand -hex 32   (letras y números: sin «+», «/» ni «=» que molesten en una URL)
BETTER_AUTH_SECRET=cambia-este-secreto
CRON_SECRET=cambia-este-otro-secreto
UMAMI_APP_SECRET=cambia-este-tercer-secreto

# ─── Copias (servicios backup-db y backup-media) ───────────────────────────────────────────────────
# Carpeta del servidor donde quedan las copias diarias (relativa a deploy/). Cópiala también fuera del servidor.
BACKUP_DIR=./backups
# Cuántos días se guardan las copias de la base (las imágenes se acumulan).
BACKUP_KEEP_DAYS=14

# ─── Imágenes (MinIO) ──────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=guerracampal
MINIO_ROOT_PASSWORD=cambia-esta-clave-larga
S3_BUCKET=guerra-campal
S3_REGION=us-east-1
# Modelo de «Quitar fondo» alojado en tu bucket (subir los archivos: docs/vps-migration.md). Se aplica al construir.
NEXT_PUBLIC_MODEL_BASE_URL=https://media.guerracampal.cl/guerra-campal/models

# ─── Correo y login ────────────────────────────────────────────────────────────────────────────────
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM="Guerra Campal <no-reply@guerracampal.cl>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Analítica ─────────────────────────────────────────────────────────────────────────────────────
# none | umami (con el Umami del compose: crea el sitio en https://stats.guerracampal.cl y copia su id). Se aplica al construir.
ANALYTICS_PROVIDER=none
UMAMI_SRC=https://stats.guerracampal.cl/script.js
UMAMI_WEBSITE_ID=

# ─── Indexación ────────────────────────────────────────────────────────────────────────────────────
# Con un SITE_URL de dominio propio el sitio ya se abre a los buscadores; esto solo importa bajo un *.vercel.app.
ALLOW_INDEXING=

# ─── Puertos de Caddy (solo para probar en tu PC; en producción déjalos como están) ────────────────
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Puerto en el servidor (solo 127.0.0.1) donde se publica Postgres para el build y para pg_dump. Cámbialo si ya usas el 5432.
# POSTGRES_PORT=5432
