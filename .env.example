# Open Fight Latam — variables de entorno.
# Copia este archivo a `.env` (desarrollo) o cárgalo en el panel de tu hosting (producción: Vercel → Settings →
# Environment Variables, o el `.env` del VPS). Nunca subas un `.env` con valores reales a git.
# Guía de producción paso a paso: docs/deploy.md · VPS: docs/vps-migration.md · Google y correo: docs/configuracion-externa.md

# ─── Base de datos ──────────────────────────────────────────────────────────────────────────────
# Postgres estándar (cualquier proveedor: Neon, Supabase, el Postgres del VPS…). Solo la cadena de conexión.
# Producción (Neon/Supabase): usa la cadena "pooled"/"transaction" si el proveedor la ofrece y termina en `?sslmode=require`.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/ofl"

# ─── Autenticación ──────────────────────────────────────────────────────────────────────────────
# Firma las sesiones del panel y los enlaces de vista previa (no hay otro secreto de vista previa).
# Genera uno por entorno con: openssl rand -base64 32
# Cambiarlo cierra todas las sesiones y vence los enlaces de vista previa ya enviados.
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-value"

# ─── Dominios ───────────────────────────────────────────────────────────────────────────────────
# El sitio público y el panel son la MISMA app en dos dominios (el proxy decide por dominio).
# En desarrollo se usan estos valores aunque falten. En producción son OBLIGATORIOS, también durante `next build`
# (la home se genera estática con SITE_URL en el HTML): sin ellos la app no arranca.
# Producción: SITE_URL="https://openfightlatam.cl" y ADMIN_URL="https://admin.openfightlatam.cl".
# Antes del dominio propio: dos alias *.vercel.app (p. ej. openfightlatam.vercel.app y openfightlatam-admin.vercel.app).
# Cambiar de dominio es solo cambiar estas dos variables y volver a desplegar (no hay URLs escritas en el código).
SITE_URL="http://localhost:3002"
ADMIN_URL="http://admin.localhost:3002"

# ─── Login con Google (opcional) ────────────────────────────────────────────────────────────────
# Si faltan, el botón «Continuar con Google» no aparece. Ver docs/configuracion-externa.md.
# Redirect autorizado en Google Cloud: <ADMIN_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Correo (invitaciones, recuperar contraseña y avisos de la bandeja) ─────────────────────────
# console = no envía nada: imprime el correo y sus enlaces en la terminal de `pnpm dev`.
# resend  = envío real; requiere RESEND_API_KEY y un MAIL_FROM de un dominio verificado en Resend.
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="Open Fight Latam <no-reply@tu-dominio.cl>"
# A dónde llegan los avisos de «Quiero pelear» y «Patrocinar» se configura en el panel: Configuración → Contacto →
# «Correo de avisos». Sin ese correo los mensajes llegan igual a la Bandeja, pero no sale ningún email.

# ─── Tareas programadas ─────────────────────────────────────────────────────────────────────────
# Protege /api/cron/purge (papelera de 30 días, subidas abandonadas, imágenes sin uso). Sin el encabezado
# `Authorization: Bearer <CRON_SECRET>` responde 401. Vercel lo envía solo (vercel.json); en un VPS, deploy/cron.
# Genera uno con: openssl rand -base64 32
CRON_SECRET="change-me-to-a-random-value"

# ─── Almacenamiento de imágenes ─────────────────────────────────────────────────────────────────
# local = carpeta .storage/ (desarrollo). s3 = Cloudflare R2, MinIO (VPS) o AWS S3 (producción).
STORAGE_DRIVER="local"
# Carpeta del driver local (por defecto .storage/ en la raíz del proyecto).
# STORAGE_LOCAL_DIR=""
# Solo con STORAGE_DRIVER="s3". Configuración del bucket (CORS, encabezados del dominio de medios): docs/deploy.md.
#   R2:    S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  ·  S3_REGION="auto"
#   MinIO: S3_ENDPOINT="http://minio:9000" (red interna)                ·  S3_REGION="us-east-1"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="ofl"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Dominio público del bucket (de donde el navegador baja las imágenes): R2 con dominio propio o MinIO detrás de Caddy.
# S3_PUBLIC_URL="https://media.tu-dominio.cl"

# ─── Quitar fondo (editor de imágenes) ──────────────────────────────────────────────────────────
# Sin esta variable el modelo (~25 MB) se baja del Hub de Hugging Face. En producción conviene alojarlo en tu bucket:
# sube config.json, preprocessor_config.json y onnx/model.onnx a <bucket>/models/Xenova/modnet/ y apunta aquí a
# <S3_PUBLIC_URL>/models. Es NEXT_PUBLIC: se incluye al construir (cambiarla pide un nuevo deploy).
# NEXT_PUBLIC_MODEL_BASE_URL="https://media.tu-dominio.cl/models"

# ─── Analítica (siempre sin cookies, sin banner) ────────────────────────────────────────────────
# none (por defecto) | vercel (Vercel Analytics) | umami (autoalojado en el VPS).
# Se decide al construir: cambiar de proveedor pide un nuevo deploy.
ANALYTICS_PROVIDER="none"
# Solo con ANALYTICS_PROVIDER="umami":
# UMAMI_SRC="https://stats.tu-dominio.cl/script.js"
# UMAMI_WEBSITE_ID="id-del-sitio-en-umami"

# ─── Indexación en buscadores ───────────────────────────────────────────────────────────────────
# Mientras SITE_URL termine en .vercel.app, robots.txt cierra el sitio a los buscadores (subdominio de prueba).
# Al lanzar con el dominio propio (openfightlatam.cl) el sitio ya se abre solo; ALLOW_INDEXING="true" abre también un
# *.vercel.app (úsalo solo si lanzas sin dominio propio). El panel nunca se indexa.
# ALLOW_INDEXING="true"

# ─── Pruebas (solo desarrollo) ──────────────────────────────────────────────────────────────────
# Base de datos de los e2e (se vacía en cada corrida).
# E2E_DATABASE_URL="postgres://postgres:postgres@localhost:5433/ofl_e2e"
