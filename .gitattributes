# Los archivos que se montan o copian a contenedores Linux deben quedar con saltos de línea LF también en Windows
# (un `#!/bin/sh` o un crontab con CRLF no arrancan).
*.sh text eol=lf
deploy/cron/* text eol=lf
deploy/postgres-init/* text eol=lf
deploy/Caddyfile text eol=lf
deploy/Dockerfile text eol=lf
deploy/*.yml text eol=lf
deploy/env.example text eol=lf
deploy/backup/* text eol=lf
